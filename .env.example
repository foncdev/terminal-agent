# terminal-agent 설정. 복사해서 .env로 쓴다.
#   cp .env.example .env
# 셸에 이미 설정된 변수가 우선한다.

# 셸을 여는 서비스라 명시적으로 켜야 뜬다. 이게 없으면 시작하지 않는다.
TERMINAL_ENABLED=true

TERMINAL_HOST=127.0.0.1
TERMINAL_PORT=4200

# 설정하면 모든 요청에 x-api-key가 필요하다. /health는 예외.
# 비워두면 인증이 없다 — 루프백에서만 그렇게 쓴다.
TERMINAL_API_KEY=

# 터미널을 띄울 수 있는 디렉터리. 유닉스는 ':', 윈도우는 ';'로 여러 개.
#
# 주의: 이것은 "시작 위치"만 제한한다. 셸이 뜬 다음 cd로 어디를 가든
# 막지 않는다. 실수를 줄이는 장치이지 보안 경계가 아니다.
TERMINAL_ALLOWED_ROOTS=~/develop

# 비워두면 유닉스는 $SHELL, 윈도우는 PowerShell을 쓴다.
TERMINAL_SHELL=

# 동시에 열어둘 수 있는 터미널 수.
TERMINAL_MAX=3

# 이만큼 아무 입출력이 없으면 셸을 정리한다. 잊어버린 셸이 쌓이지 않게.
TERMINAL_IDLE_MINUTES=30

# 터미널마다 메모리에 들고 있을 최근 출력량(바이트).
# 새로 붙는 클라이언트에게 화면을 되살려주는 데 쓴다.
TERMINAL_SCROLLBACK_BYTES=262144

# --- 중계 서버 연결 (선택) ---
#
# 이걸 설정하면 이쪽에서 중계 서버로 붙는다. 그래야 웹에서도
# 같은 터미널을 밖에서도 볼 수 있다. 비워두면 이 기기에서만 쓴다.

# 중계 서버 주소. 경로(/terminal-agent)까지 적어야 한다.
RELAY_URL=ws://127.0.0.1:4100/terminal-agent

# 중계 서버 쪽과 같은 값이어야 한다.
# 서버 쪽이 비어 있으면 접속을 아예 거부한다.
RELAY_TERMINAL_TOKEN=

# 서버 목록에 보일 이름. 비우면 호스트명.
RELAY_AGENT_NAME=
